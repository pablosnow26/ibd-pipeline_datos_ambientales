    },
    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  const raw = item.json.estacion;\n  \n  // Creamos el objeto limpio 'data_processed'\n  item.json.data_processed = {\n    id: raw.CODIGO,\n    nombre: raw.ESTACION.trim(),\n    // Cambiamos \"40,42\" por 40.42 (número real)\n    latitud: parseFloat(raw.LATITUD.replace(',', '.')),\n    longitud: parseFloat(raw.LONGITUD.replace(',', '.')),\n    direccion: raw.DIRECCION,\n    fecha_procesamiento: new Date().toISOString()\n  };\n\n  // Borramos lo antiguo para no arrastrar basura\n  delete item.json.estacion;\n}\n\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        0
      ],
      "id": "1a0ecdd9-9674-44d3-bd3d-112bc3bc0541",
