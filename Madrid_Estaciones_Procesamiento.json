    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  const silver = item.json.data_processed;\n  \n  // Creamos el objeto Gold: listo para consumo directo\n  item.json.data_access = {\n    estacion: silver.nombre.toUpperCase(),\n    // Mantenemos solo lo esencial para el mapa\n    coords: `${silver.latitud},${silver.longitud}`,\n    lat: silver.latitud,\n    lon: silver.longitud,\n    // Podemos añadir una etiqueta formateada para el popup del mapa\n    popup_info: `Estación: ${silver.nombre} (ID: ${silver.id})`,\n    zona: \"MADRID-CENTRO\" // Podrías añadir lógica de negocio aquí\n  };\n\n  // Limpiamos los datos intermedios para que el CSV final sea ligero\n  delete item.json.data_processed;\n}\n\nreturn $input.all();"
      },
