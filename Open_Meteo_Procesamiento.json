      "parameters": {
        "jsCode": "const items = $input.all();\nif (items.length === 0) return [];\n\n// Procesamos cada ítem y lo devolvemos como un elemento independiente de la lista\nlet resultado = items.map(item => {\n    let datosLimpios = item.json;\n    \n    // Extraemos la fecha y hora\n    let fecha = new Date(datosLimpios.fecha_hora); \n    datosLimpios.year = fecha.getFullYear().toString();\n    datosLimpios.month = String(fecha.getMonth() + 1).padStart(2, '0');\n    datosLimpios.day = String(fecha.getDate()).padStart(2, '0');\n    datosLimpios.hour = String(fecha.getHours()).padStart(2, '0');\n    \n    // Eliminamos los campos originales para que quede limpio\n    delete datosLimpios.fecha_hora;\n    delete datosLimpios.fecha;\n    \n    // IMPORTANTE: n8n exige que cada ítem tenga la clave \"json\" internamente\n    return {\n        json: datosLimpios\n    };\n});\n\n// Devolvemos la lista plana directamente\nreturn resultado;"
      },
