    {
      "parameters": {
        "jsCode": "// 1. Obtenemos la respuesta de la API de Calidad del Aire\nconst data = $input.first().json;\nconst hourly = data.hourly;\nconst registros = [];\n\n// 2. Recorremos las 24 horas exactas de ayer\nfor (let i = 0; i < hourly.time.length; i++) {\n  // 3. Empaquetamos cada hora en su propio mensaje JSON\n  registros.push({\n    json: {\n      fecha_hora: hourly.time[i],\n      pm10: hourly.pm10[i],                 // Partículas PM10\n      pm2_5: hourly.pm2_5[i],               // Partículas PM2.5\n      no2: hourly.carbon_monoxide[i],      // Dióxido de Nitrógeno\n      latitud: data.latitude,\n      longitud: data.longitude\n    }\n  });\n}\n\n// 4. Salen 24 items hacia RabbitMQ\nreturn registros;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        656,
        192
      ],
